# InfraGuard Environment Configuration Example
# Copy to .env for local runtime configuration

INFRAGUARD_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=sqlite:///./data/infraguard.db

# Security & Authentication
SECRET_KEY=replace_with_a_secure_random_key_in_production_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256
ALLOWED_ORIGINS=*


# Storage Settings
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed
MAX_UPLOAD_SIZE_MB=50

# Map Default Coordinates (Tamil Nadu, India)
DEFAULT_MAP_LAT=11.1271
DEFAULT_MAP_LNG=78.6569
DEFAULT_MAP_ZOOM=7

# Sensor & AUKF Tolerances
AUKF_ALPHA=0.001
AUKF_BETA=2.0
AUKF_KAPPA=0.0
DUPLICATE_GPS_THRESHOLD_METERS=15.0
DUPLICATE_TIME_THRESHOLD_HOURS=72.0
